# ── ONE Drive-in Automation — Environment Variables Template ──────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git.

# ── Supabase ───────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Telegram Bot ───────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
KITCHEN_CHAT_ID=-1001234567890        # Telegram group chat ID for kitchen staff
MANAGER_CHAT_ID=1234567890            # Telegram personal chat ID for manager

# ── Drive-in GPS Coordinates (Jubilee Hills, Hyderabad) ────────────────────────
DRIVEIN_LAT=17.4318
DRIVEIN_LNG=78.4082
PROXIMITY_KM=5                         # Radius in km to detect customer arrival

# ── Make.com ───────────────────────────────────────────────────────────────────
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/your_webhook_id

# ── Razorpay (Payment Gateway) ─────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ── Known Telegram Users (optional — for manager alerts) ───────────────────────
# Format: username:chat_id pairs comma-separated
# KNOWN_TELEGRAM_USERS=username1:123456789,username2:987654321
