{
  "name": "route66-drivein-eta",
  "version": "0.1.0",
  "private": true,
  "description": "Route 66 Drive-In — US order-on-the-go ETA agent scaffold for Vultr Agent Rush Challenge 1.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
