    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.2"
  }
}
