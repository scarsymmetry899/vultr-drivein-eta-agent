# Route 66 Drive-In — environment template
# Copy to .env and fill in values on the Vultr VM. Never commit .env.
# This scaffold runs with the defaults below. No key is required for local demo.

# ── HTTP (Vultr VM control plane) ─────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080

# Pit board and staff actions stay locked until this is set.
# The VM setup script generates one and prints it once. Do not commit a real token.
KITCHEN_TOKEN=

# ── Lot (fictional Route 66 Drive-In, Austin, TX) ─────────────────────────────
DRIVEIN_NAME=Route 66 Drive-In
DRIVEIN_CITY=Austin, TX
DRIVEIN_TIMEZONE=America/Chicago
DRIVEIN_OPEN=11:00
DRIVEIN_CLOSE=22:00
# Demo pin. South Congress area. Not a real restaurant listing.
DRIVEIN_LAT=30.2500
DRIVEIN_LNG=-97.7490
# Demo combined sales-tax rate. Not tax advice.
SALES_TAX_RATE=0.0825

# Minutes the bag should sit ready before the quoted ETA.
FIRE_BUFFER_MINUTES=3
# How many tickets may be firing at the same time.
KITCHEN_CAPACITY=3

# ── Orders ────────────────────────────────────────────────────────────────────
# SQLite file. Created on startup. Do not commit it.
DATABASE_PATH=data/drivein.sqlite

# ── Vultr Serverless Inference (OpenAI-compatible) ────────────────────────────
# Docs: https://docs.vultr.com/vultr-inference-api
# demo: never calls the network. The sentence is deterministic.
# live: calls https://api.vultrinference.com/v1 only. The app ignores any other host
#       so the key is not sent elsewhere. Requires a key and a model. Model text is
#       checked and cannot set the fire time. A bad response is discarded.
# Put the key only in this file on the VM. It is not passed into the sandbox.
INFERENCE_MODE=demo
# Kept so older notes stay recognizable. The process does not read this value.
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_MODEL=

# ── Docker sandbox ────────────────────────────────────────────────────────────
# inprocess: demo on a laptop. Isolation is none. The response says so.
# docker:    required on the VM. If the container fails, the ticket is not scheduled.
SANDBOX_RUNNER=inprocess
SANDBOX_IMAGE=route66-fire-solver
SOLVER_TIMEOUT_MS=5000
SOLVER_MAX_OUTPUT_BYTES=16384
SANDBOX_MEMORY=128m
SANDBOX_CPUS=0.50
SANDBOX_PIDS=32

# Not used by this app (Hyderabad seed only — see reference/one-drivein):
# Make.com webhooks, Telegram bot tokens, Razorpay keys, Supabase service-role keys.
