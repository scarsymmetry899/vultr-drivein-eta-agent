# Route 66 Drive-In — environment template
# Copy to .env and fill in values on the Vultr VM. Never commit .env.
# This scaffold runs with the defaults below. No key is required for local demo.

# ── HTTP (Vultr VM control plane) ─────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080

# ── Lot (fictional Route 66 Drive-In, Austin, TX) ─────────────────────────────
DRIVEIN_NAME=Route 66 Drive-In
DRIVEIN_CITY=Austin, TX
DRIVEIN_TIMEZONE=America/Chicago
DRIVEIN_OPEN=11:00
DRIVEIN_CLOSE=22:00
# Demo pin. South Congress area. Not a real restaurant listing.
DRIVEIN_LAT=30.2500
DRIVEIN_LNG=-97.7490
# Demo combined sales-tax rate. Not tax advice.
SALES_TAX_RATE=0.0825

# Minutes the bag should sit ready before the quoted ETA.
FIRE_BUFFER_MINUTES=3
# How many tickets may be firing at the same time.
KITCHEN_CAPACITY=3

# ── Vultr Serverless Inference (OpenAI-compatible) ────────────────────────────
# Docs: https://docs.vultr.com/vultr-inference-api
# Leave the key empty to use the local stub. The stub never invents fire times.
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_MODEL=

# ── Docker sandbox ────────────────────────────────────────────────────────────
# inprocess: run the pure solver inside the API (default, no Docker required).
# docker:    docker run the image below with no network and a memory cap.
SANDBOX_RUNNER=inprocess
SANDBOX_IMAGE=route66-fire-solver
SOLVER_TIMEOUT_MS=5000
SANDBOX_MEMORY=128m
SANDBOX_CPUS=0.50
SANDBOX_PIDS=32

# Optional later: a Postgres URL that matches db/schema.sql.
# DATABASE_URL=

# Not used by this app (Hyderabad seed only — see reference/one-drivein):
# Make.com webhooks, Telegram bot tokens, Razorpay keys, Supabase service-role keys.
